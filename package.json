{
  "name": "thought-haus",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev -w packages/app",
    "build": "npm run build -w packages/app",
    "build:clipper": "npm run build -w packages/clipper",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:webdav": "node dev/webdav-server.mjs",
    "dev:docs": "npm run dev -w packages/docs",
    "build:docs": "npm run build -w packages/docs",
    "build:deploy": "npm run build && npm run build:docs && cp -r dist-docs/ packages/app/dist/docs/"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.10.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "webdav-server": "^2.6.2"
  }
}
